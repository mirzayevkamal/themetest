    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "postcss": "8.5.26",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.1",
    "tailwindcss": "^3.4.19",
