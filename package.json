{
  "name": "grocery",
  "version": "1.0.0",
  "description": "grocery - a Salla React theme",
  "type": "module",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
